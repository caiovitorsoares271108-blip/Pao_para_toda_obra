# Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy alternative, not required when SUPABASE_SECRET_KEY is set:
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_KEY is only a fallback when its value is a valid private server key.
# SUPABASE_KEY=

# Never use a publishable/anon key as backend credentials.
JWT_SECRET=gere-uma-chave-longa-e-aleatoria
JWT_EXPIRE_MINUTES=43200
ENVIRONMENT=development
SEED_DEMO_DATA=true
# Acesso rápido só em desenvolvimento; corresponda a uma conta admin ativa.
QUICK_ADMIN_EMAIL=
QUICK_ADMIN_PASSWORD=
# Contas demo opcionais: use apenas em desenvolvimento local e defina credenciais privadas.
DEMO_ADMIN_NAME=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_CUSTOMER_NAME=
DEMO_CUSTOMER_EMAIL=
DEMO_CUSTOMER_PASSWORD=
# Defina estas credenciais privadas no Render para criar as contas uma vez.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_CUSTOMER_NAME=
INITIAL_CUSTOMER_EMAIL=
INITIAL_CUSTOMER_PASSWORD=
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
