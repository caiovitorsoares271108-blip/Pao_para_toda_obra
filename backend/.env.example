# Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Supabase > Connect > URI PostgreSQL (usada pelo backend)
DATABASE_URL=
JWT_SECRET=gere-uma-chave-longa-e-aleatoria
JWT_EXPIRE_MINUTES=43200
ENVIRONMENT=development
SEED_DEMO_DATA=true
# Contas demo opcionais: use apenas em desenvolvimento local e defina credenciais privadas.
DEMO_ADMIN_NAME=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_CUSTOMER_NAME=
DEMO_CUSTOMER_EMAIL=
DEMO_CUSTOMER_PASSWORD=
# Defina estas credenciais privadas no Render para criar as contas uma vez.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_CUSTOMER_NAME=
INITIAL_CUSTOMER_EMAIL=
INITIAL_CUSTOMER_PASSWORD=
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
